-- See https://wiki.hypr.land/Configuring/Basics/Autostart/

-- Start a tray app only once a tray host (Dux, Waybar, ...) is on the session
-- bus, or after 30 s at the latest. Apps started before it exists never show
-- a tray icon.
local function exec_after_tray(cmd)
  hl.exec_cmd("timeout 30 sh -c 'until busctl --user status org.kde.StatusNotifierWatcher >/dev/null 2>&1; do sleep 0.5; done'; exec " .. cmd)
end

hl.on("hyprland.start", function()
  hl.exec_cmd(
    "dbus-update-activation-environment --systemd DISPLAY XAUTHORITY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=Hyprland")
{{- if ne .chezmoi.osRelease.id "nixos" }}
  -- Arch only: on NixOS, UWSM, the NixOS portal/keyring modules and Dux Shell
  -- (polkit agent, lock, idle) cover these, and the /usr/lib paths don't exist.
  hl.exec_cmd("/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1")
  hl.exec_cmd("/usr/lib/xdg-desktop-portal")
  hl.exec_cmd("/usr/lib/xdg-desktop-portal-hyprland")
  hl.exec_cmd("gnome-keyring-daemon --start --components=secrets")
  hl.exec_cmd("hypridle")
{{- end }}
  -- hl.exec_cmd("waybar & hyprpaper")
  -- hl.exec_cmd("nm-applet")
  exec_after_tray("protonvpn-app --start-minimized")
  exec_after_tray("signal-desktop --start-in-tray")
  -- hl.exec_cmd("openrgb --startminimized --profile \"orange\" --server")
  exec_after_tray("1password --silent")
  exec_after_tray("flameshot")
end)
